# Obligatoire. Créez une NOUVELLE clé : ne réutilisez pas une clé déjà publiée.
INCEPTION_API_KEY=

# Fortement recommandé pour empêcher des inconnus de consommer votre quota.
MERCY_API_TOKEN=

# Modèle et génération
DEFAULT_MODEL=mercury-3
DEFAULT_REASONING_EFFORT=low
MAX_COMPLETION_TOKENS=1200
# Sert uniquement à calculer une projection du nombre de requêtes, pas le solde réel.
FREE_TOKEN_REFERENCE=100000000
UPSTREAM_TIMEOUT_MS=55000

# Historique (7 jours par défaut)
CONVERSATION_TTL_SECONDS=604800
MAX_HISTORY_MESSAGES=24
MAX_HISTORY_CHARS=60000

# Persistance recommandée sur Vercel (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Images
ENABLE_VISION=true
MAX_IMAGE_BYTES=7340032
IMAGE_TIMEOUT_MS=12000
# Facultatif : liste stricte séparée par des virgules, ex. images.example.com,cdn.example.com
IMAGE_HOST_ALLOWLIST=

# CORS : * ou liste d'origines séparées par des virgules
ALLOWED_ORIGINS=*
